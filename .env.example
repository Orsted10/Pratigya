# RocketRide development connection
ROCKETRIDE_URI=https://staging.rocketride.ai:443
ROCKETRIDE_APIKEY=rr_development_key_here

# RocketRide deployment target
ROCKETRIDE_DEPLOY_URI=https://staging.rocketride.ai:443
ROCKETRIDE_DEPLOY_APIKEY=rr_deployment_target_key_here

# Groq LPU Fast Inference API Key (Get free key from console.groq.com)
GROQ_API_KEY=gsk_your_groq_lpu_api_key_here

# Supabase Vector DB & Backend (Get from supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here
